<Window x:Class="RetroNetplayLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RetroNetplay Launcher" Height="400" Width="420" Background="#F3F3F3" Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Server Address & Role Selection -->
            <RowDefinition Height="*"/>
            <!-- Dynamic Configuration / Lobby Details -->
            <RowDefinition Height="Auto"/>
            <!-- Action Status Footer -->
        </Grid.RowDefinitions>

        <!-- STAGE 1: Server Setup & Role Choice (Always Visible) -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <GroupBox Header="Server Connection">
                <StackPanel Margin="10">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Server Addr: " VerticalAlignment="Center" Width="85"/>
                        <TextBox x:Name="ServerIpTxt" Grid.Column="1" Text="yourname.synology.me" VerticalContentAlignment="Center" Padding="4,2"/>
                    </Grid>

                    <!-- Primary Initial Options -->
                    <Grid x:Name="RoleSelectionGrid" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ChooseHostBtn" Content="🏠 Host a Game" Height="35" Margin="0,0,5,0" FontWeight="Bold" Click="ChooseHostBtn_Click"/>
                        <Button x:Name="ChooseJoinBtn" Content="🌐 Join a Friend" Grid.Column="1" Height="35" Margin="5,0,0,0" FontWeight="Bold" Click="ChooseJoinBtn_Click"/>
                    </Grid>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- STAGE 2: Dynamic Core Screens / Lobby Layout -->
        <Grid Grid.Row="1">
            <!-- HOST CONFIG PANEL (Hidden Initially) -->
            <StackPanel x:Name="HostConfigPanel" Visibility="Collapsed">
                <GroupBox Header="Host Session Configuration">
                    <StackPanel Margin="10">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Emulator Core:" VerticalAlignment="Center" Width="95"/>
                            <ComboBox x:Name="EmulatorComboBox" Grid.Column="1" SelectionChanged="EmulatorComboBox_SelectionChanged"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Game ROM:" VerticalAlignment="Center" Width="95"/>
                            <TextBox x:Name="RomPathTxt" Grid.Column="1" IsReadOnly="True" Background="#EAEAEA" VerticalContentAlignment="Center"/>
                            <Button x:Name="BrowseRomBtn" Content="Browse..." Width="70" Grid.Column="2" Margin="5,0,0,0" Click="BrowseRomBtn_Click"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max Players:" VerticalAlignment="Center" Width="95"/>
                            <ComboBox x:Name="MaxPlayersComboBox" Grid.Column="1" Width="60" SelectedIndex="0">
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                            </ComboBox>
                            <Button x:Name="HostFinalBtn" Content="Open Lobby" Grid.Column="2" HorizontalAlignment="Right" Width="100" FontWeight="Bold" Click="HostFinalBtn_Click" IsEnabled="False"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- JOIN CONFIG PANEL (Hidden Initially) -->
            <StackPanel x:Name="JoinConfigPanel" Visibility="Collapsed">
                <GroupBox Header="Join Configuration">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Enter Room Code: " VerticalAlignment="Center" Width="110"/>
                        <TextBox x:Name="RoomCodeTxt" Grid.Column="1" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="14" FontWeight="Bold" CharacterCasing="Upper" MaxLength="4"/>
                        <Button x:Name="JoinFinalBtn" Content="Connect" Grid.Column="2" Margin="10,0,0,0" Height="26" FontWeight="Bold" Click="JoinFinalBtn_Click"/>
                    </Grid>
                </GroupBox>
            </StackPanel>

            <!-- SHARED LOBBY ROSTER PANEL (Hidden Initially, populates after connecting) -->
            <Grid x:Name="LobbyPanel" Visibility="Collapsed">
                <GroupBox Header="Connected Players Lobby">
                    <Grid Margin="5">
                        <ListBox x:Name="PlayerListBox" Background="White" BorderThickness="0" Margin="0,0,0,5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                                        <TextBlock Text="🎮 " Foreground="#4CAF50"/>
                                        <TextBlock Text="{Binding Ip}" FontWeight="Bold"/>
                                        <TextBlock Text=":" Foreground="#888888"/>
                                        <TextBlock Text="{Binding Port}" Foreground="#888888"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="DisplayRoomCodeTxt" Text="CODE: ----" FontSize="22" FontWeight="Bold" 
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,10,0" Foreground="#2196F3"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- FOOTER BAR: Status text and Host Execution Button -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusTxt" Text="Status: Select your role to begin." VerticalAlignment="Center" Foreground="#666666" TextWrapping="Wrap" MaxWidth="240" HorizontalAlignment="Left"/>
            <Button x:Name="StartGameBtn" Grid.Column="1" Content="Start Emulation" Width="120" Height="30" 
                    Visibility="Collapsed" Click="StartGameBtn_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
