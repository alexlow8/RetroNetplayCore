<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    
    <!-- Force compiling to the exact folder without appending sub-directories -->
    <BaseOutputPath>C:\Users\Alex\source\repos\RetroNetplayCore\RetroNetplayCore\bin</BaseOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\RetroNetplayCore\bin\$(Configuration)\</OutputPath>  
    <PlatformTarget>x64</PlatformTarget>  
    <AssemblyVersion>0.0.0.3</AssemblyVersion>  
    <FileVersion>0.0.0.3</FileVersion>  
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>

  <!-- Force a loose copy of our primary executable into the target root directory -->
  <Target Name="PostBuildInstallerCopy" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(TargetDir)$(TargetName).exe" DestinationFiles="$(ProjectDir)$(TargetName).exe" ContinueOnError="true" />
  </Target>
</Project>
