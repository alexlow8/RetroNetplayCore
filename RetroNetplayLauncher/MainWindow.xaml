<Window x:Class="RetroNetplayLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RetroNetplay Core Configuration Engine" Height="420" Width="480"
        Background="#1E1E1E" Foreground="#FFFFFF" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Text="🚀 ENGINE SUBSYSTEM SETUP" FontSize="20" FontWeight="Bold" Foreground="#00FFFF" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Form Fields -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <!-- Ports Row -->
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Local Port:" Margin="0,0,0,5" Foreground="#CCCCCC"/>
                        <TextBox x:Name="TxtLocalPort" Text="8000" Padding="5" Background="#2D2D2D" Foreground="#FFFFFF" BorderBrush="#555555"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Friend's Port:" Margin="0,0,0,5" Foreground="#CCCCCC"/>
                        <TextBox x:Name="TxtFriendPort" Text="8001" Padding="5" Background="#2D2D2D" Foreground="#FFFFFF" BorderBrush="#555555"/>
                    </StackPanel>
                </Grid>

                <!-- Core Path Selection -->
                <TextBlock Text="Libretro Core Library Path (.dll):" Margin="0,15,0,5" Foreground="#CCCCCC"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtCorePath" Text="Emulators\MockLibretroCore.dll" Padding="5" Background="#2D2D2D" Foreground="#FFFFFF" BorderBrush="#555555"/>
                    <Button Grid.Column="1" Content="Browse..." Margin="5,0,0,0" Click="BrowseCore_Click" Background="#3D3D3D" Foreground="#FFFFFF"/>
                </Grid>

                <!-- ROM Path Selection -->
                <TextBlock Text="Game ROM Path (.z64 / .n64):" Margin="0,15,0,5" Foreground="#CCCCCC"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtRomPath" Text="dummy.z64" Padding="5" Background="#2D2D2D" Foreground="#FFFFFF" BorderBrush="#555555"/>
                    <Button Grid.Column="1" Content="Browse..." Margin="5,0,0,0" Click="BrowseRom_Click" Background="#3D3D3D" Foreground="#FFFFFF"/>
                </Grid>
            </StackPanel>

            <!-- Boot Button -->
            <Button Grid.Row="2" Content="LAUNCH HIGH-PERFORMANCE ENGINE" Padding="12" FontSize="14" FontWeight="Bold" 
                Background="#FFD700" Foreground="#1E1E1E" Click="LaunchEngine_Click" BorderThickness="0"/>
        </Grid>
    </Window>
